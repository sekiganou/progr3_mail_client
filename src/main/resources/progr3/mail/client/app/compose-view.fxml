<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="15.0" 
      xmlns:fx="http://javafx.com/fxml/1" 
      xmlns="http://javafx.com/javafx/21.0.3-internal" 
      fx:controller="progr3.mail.client.app.ComposeViewController"
      style="-fx-background-color: #ffffff;">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header -->
    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <Label fx:id="headerLabel" 
              text="Compose New Message" 
              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button fx:id="backButton" 
                text="← Back to Messages" 
                onAction="#onBackClick"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8px 15px; -fx-background-radius: 5px; -fx-cursor: hand;" />
    </HBox>

    <!-- From Field (Read-only) -->
    <VBox spacing="5.0">
        <Label text="From:" 
               style="-fx-font-weight: bold; -fx-text-fill: #666666; -fx-font-size: 13px;" />
        <Label fx:id="fromLabel" 
               text="" 
               
               style="-fx-text-fill: #333333; -fx-font-size: 14px; -fx-padding: 8px; -fx-background-color: #f5f5f5; -fx-background-radius: 3px;" />
    </VBox>

    <!-- To Field -->
    <VBox spacing="5.0">
        <Label text="To: (separate multiple recipients with commas)" 
               style="-fx-font-weight: bold; -fx-text-fill: #666666; -fx-font-size: 13px;" />
        <TextField fx:id="toField" 
                   promptText="recipient1@example.com, recipient2@example.com" 
                   style="-fx-font-size: 14px; -fx-padding: 10px;" />
    </VBox>

    <!-- Subject Field -->
    <VBox spacing="5.0">
        <Label text="Subject:" 
               style="-fx-font-weight: bold; -fx-text-fill: #666666; -fx-font-size: 13px;" />
        <TextField fx:id="subjectField" 
                   promptText="Enter subject" 
                   style="-fx-font-size: 14px; -fx-padding: 10px;" />
    </VBox>

    <!-- Body Field -->
    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
        <Label text="Message:" 
               style="-fx-font-weight: bold; -fx-text-fill: #666666; -fx-font-size: 13px;" />
        <TextArea fx:id="bodyArea" 
                  promptText="Type your message here..." 
                  wrapText="true"
                  VBox.vgrow="ALWAYS"
                  prefHeight="300.0"
                  style="-fx-font-size: 14px; -fx-padding: 10px;" />
    </VBox>

    <!-- Action Buttons -->
    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <Button fx:id="sendButton" 
                text="Send Message" 
                onAction="#onSendClick"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 30px; -fx-background-radius: 5px; -fx-cursor: hand;" />
        
        <Button fx:id="clearButton" 
                text="Clear" 
                onAction="#onClearClick"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 30px; -fx-background-radius: 5px; -fx-cursor: hand;" />
        
        <HBox HBox.hgrow="ALWAYS" />
        
        <Label fx:id="statusLabel" 
               text="" 
               style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
    </HBox>

    <!-- Character Counter -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Label fx:id="charCountLabel" 
               text="Characters: 0" 
               style="-fx-font-size: 11px; -fx-text-fill: #999999;" />
    </HBox>
</VBox>